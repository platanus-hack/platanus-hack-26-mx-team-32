# Supabase — server-side config for the backend.
# Reads work with the publishable (anon) key; switch to the service_role key
# only when we add writes that RLS would block.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<publishable-or-service-role-key>

# CORS — the Vite frontend origin(s), comma-separated.
# Note: any https://*.vercel.app origin is also allowed via allow_origin_regex
# in main.py, so deployed Vercel frontends work without listing each one here.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://app-chi-ten-94.vercel.app

# Firecrawl — web/news search for victim cases.
# https://firecrawl.dev
FIRECRAWL_API_KEY=fc-...
